{
  "name": "nitrostack-knowledge-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "mcp": "tsx mcp/index.ts",
    "test:mcp:live": "tsx tests/mcp.live.ts",
    "check": "tsc --noEmit",
    "setup": "node --env-file-if-exists=.env.local scripts/setup.ts",
    "crawl": "node --env-file-if-exists=.env.local scripts/crawl.ts",
    "test": "node --test tests/*.test.ts",
    "evaluate": "node --env-file-if-exists=.env.local scripts/evaluate.ts"
  },
  "dependencies": {
    "@nitrostack/core": "^1.1.3",
    "cheerio": "^1.1.0",
    "dotenv": "^17.4.2",
    "lucide-react": "^0.577.0",
    "mongodb": "^7.0.0",
    "next": "^16.2.0",
    "on-headers": "^1.1.0",
    "pdf-parse": "^2.4.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "reflect-metadata": "^0.2.2",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/express": "^4.17.25",
    "@types/node": "^24.0.0",
    "@types/on-headers": "^1.0.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.9.0"
  }
}
